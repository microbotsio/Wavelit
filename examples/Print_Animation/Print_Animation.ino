uint8_t frame_num = 0U;
uint16_t frame_timer = 0U;

void setup() {
  Serial.begin(115200);  // Set Serial baud rate to 115200. Ensure Tools/USB_CDC_On_Boot is enabled if using Serial.
  myWavelit.Init();      // Initializes Wavelit
}

void loop() {
  myWavelit.Run();

  frame_timer++;
  if(frame_timer>5000){
    frame_timer=0;
    frame_num++;
  }

  switch(frame_num){
    case 1:
      myWavelit.PrintImage(space_invader_frame1, sizeof(space_invader_frame1));
    break;
    case 2:
      myWavelit.PrintImage(space_invader_frame2, sizeof(space_invader_frame2));
    break;
    default:
    frame_num=0;
    break;
  }
}
